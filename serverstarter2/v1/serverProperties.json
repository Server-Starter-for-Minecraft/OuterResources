{
  "$schema": "./schema/serverProperties.schema.json",
  "groups": [
    {
      "id": "base",
      "label": {
        "ja": "基本設定",
        "en-US": "base settings"
      }
    },
    {
      "id": "player",
      "label": {
        "ja": "プレイヤー",
        "en-US": "player settings"
      }
    },
    {
      "id": "server",
      "label": {
        "ja": "サーバー",
        "en-US": "server settings"
      }
    },
    {
      "id": "generator",
      "label": {
        "ja": "ワールド設定",
        "en-US": "world settings"
      }
    },
    {
      "id": "spawning",
      "label": {
        "ja": "ワールドスポーン",
        "en-US": "world spawn"
      }
    },
    {
      "id": "world",
      "label": {
        "ja": "ワールド本体",
        "en-US": "world"
      }
    },
    {
      "id": "network",
      "label": {
        "ja": "ネットワーク",
        "en-US": "network"
      }
    },
    {
      "id": "rcon-query",
      "label": {
        "ja": "RCON / Query",
        "en-US": "RCON / Query"
      }
    },
    {
      "id": "command",
      "label": {
        "ja": "コマンド",
        "en-US": "command"
      }
    },
    {
      "id": "resourcepack",
      "label": {
        "ja": "リソースパック",
        "en-US": "resourcepack"
      }
    },
    {
      "id": "security",
      "label": {
        "ja": "セキュリティ",
        "en-US": "security"
      }
    }
  ],
  "properties": {
    "accepts-transfers": {
      "description": {
        "ja": "他のサーバーから転送（/transfer コマンドなど）されてきたプレイヤーの接続を受け入れる",
        "en-US": "Accept players transferred from other servers (e.g. by the /transfer command)"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "24w03a"
          },
          "type": "boolean",
          "default": false
        }
      ]
    },
    "allow-flight": {
      "groups": [
        "world"
      ],
      "description": {
        "ja": "サバイバルモードでの飛行（MODなどによる）を許可する（無効の場合，5秒以上空中に浮いているプレイヤーはキックされる）",
        "en-US": "Allow flight in Survival mode (e.g. with mods). When disabled, players floating in the air for more than 5 seconds are kicked"
      },
      "definitions": [
        {
          "type": "boolean",
          "default": false
        }
      ]
    },
    "allow-nether": {
      "groups": [
        "generator"
      ],
      "description": {
        "ja": "ネザーに移動可能",
        "en-US": "Possible to move to the Nether"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "to": "25w34b"
          },
          "type": "boolean",
          "default": true
        }
      ]
    },
    "allowed-connection-ids": {
      "groups": [
        "network"
      ],
      "description": {
        "ja": "接続を受け入れる接続ID（サーバーアドレスの最初の @ より前の部分）をカンマ区切りで指定（空欄の場合は制限しない，暗号化されないためセキュリティ目的には使わないこと）",
        "en-US": "Comma-separated connection IDs (the part of the server address before the first @) to accept (no restriction when empty; not encrypted, so do not rely on it for security)"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "26.4-snapshot-1"
          },
          "type": "string",
          "default": ""
        }
      ]
    },
    "announce-player-achievements": {
      "groups": [
        "player"
      ],
      "description": {
        "ja": "プレイヤーが実績を解除したときにチャットで通知する（1.12 以降はゲームルール announceAdvancements に置き換え）",
        "en-US": "Announce in chat when a player earns an achievement (replaced by the announceAdvancements game rule in 1.12)"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "1.7.2",
            "to": "17w17b"
          },
          "type": "boolean",
          "default": true
        }
      ]
    },
    "broadcast-console-to-ops": {
      "groups": [
        "rcon-query"
      ],
      "description": {
        "ja": "サーバーコンソールからコマンドが入力された際に，OP権限を有するプレイヤーに通知する",
        "en-US": "Notifies the player with OP authority when a command is entered from the server console"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "1.8.4"
          },
          "type": "boolean",
          "default": true
        }
      ]
    },
    "broadcast-rcon-to-ops": {
      "groups": [
        "rcon-query"
      ],
      "description": {
        "ja": "リモートコントロールからコマンドが入力された際に，OP権限を有するプレイヤーに通知する",
        "en-US": "Notifies the player with OP when a command is input from a remote control"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "1.7.5"
          },
          "type": "boolean",
          "default": true
        }
      ]
    },
    "bug-report-link": {
      "description": {
        "ja": "プレイヤーに「バグを報告」の案内先として提示するURL（空欄の場合は案内しない）",
        "en-US": "URL presented to players as the place to report bugs (not presented when empty)"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "24w21a"
          },
          "type": "string",
          "default": ""
        }
      ]
    },
    "chat-spam-threshold-seconds": {
      "description": {
        "ja": "チャットを短時間に送りすぎたプレイヤーを自動でキックする際の判定基準（0でキックしない）",
        "en-US": "Threshold for automatically kicking players who send too many chat messages in a short time (0 to never kick)"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "26.2-pre-1"
          },
          "type": "number",
          "default": 10,
          "min": 0,
          "step": 1
        }
      ]
    },
    "command-spam-threshold-seconds": {
      "description": {
        "ja": "コマンドを短時間に実行しすぎたプレイヤーを自動でキックする際の判定基準（0でキックしない）",
        "en-US": "Threshold for automatically kicking players who run too many commands in a short time (0 to never kick)"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "26.2-pre-1"
          },
          "type": "number",
          "default": 10,
          "min": 0,
          "step": 1
        }
      ]
    },
    "difficulty": {
      "groups": [
        "base",
        "player"
      ],
      "description": {
        "ja": "ゲーム難易度",
        "en-US": "Game difficulty"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "18w48a"
          },
          "type": "string",
          "default": "easy",
          "enum": [
            "peaceful",
            "easy",
            "normal",
            "hard"
          ]
        },
        {
          "minecraftVersion": {
            "to": "18w47b"
          },
          "type": "string",
          "default": "1",
          "enum": [
            "0",
            "1",
            "2",
            "3"
          ]
        }
      ]
    },
    "enable-code-of-conduct": {
      "description": {
        "ja": "サーバーの行動規範をプレイヤーに表示する（codeofconductフォルダに「言語コード.txt」の形式で配置した文章を使用）",
        "en-US": "Show the server code of conduct to players (uses \"<language code>.txt\" files placed in the codeofconduct folder)"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "25w34a"
          },
          "type": "boolean",
          "default": false
        }
      ]
    },
    "enable-command-block": {
      "groups": [
        "command"
      ],
      "description": {
        "ja": "コマンドブロックの実行を許可",
        "en-US": "Allow command block execution"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "1.4",
            "to": "25w34b"
          },
          "type": "boolean",
          "default": false
        }
      ]
    },
    "enable-jmx-monitoring": {
      "description": {
        "ja": "JMXによるモニターを有効化",
        "en-US": "Enable monitoring by JMX"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "20w16a"
          },
          "type": "boolean",
          "default": false
        }
      ]
    },
    "enable-legacy-status": {
      "groups": [
        "server"
      ],
      "description": {
        "ja": "1.7より前のクライアントからのサーバー情報の問い合わせ（旧形式のステータス・Ping）に応答する",
        "en-US": "Respond to server status requests (legacy status and ping) from clients older than 1.7"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "26.4-snapshot-1"
          },
          "type": "boolean",
          "default": true
        }
      ]
    },
    "enable-query": {
      "groups": [
        "rcon-query"
      ],
      "description": {
        "ja": "GameSpy4 プロトコルによるサーバー情報の問い合わせ（Query）を許可する",
        "en-US": "Allow server information queries using the GameSpy4 protocol (Query)"
      },
      "definitions": [
        {
          "type": "boolean",
          "default": false
        }
      ]
    },
    "enable-rcon": {
      "groups": [
        "rcon-query"
      ],
      "description": {
        "ja": "リモートコントロールを許可",
        "en-US": "Allow remote control"
      },
      "definitions": [
        {
          "type": "boolean",
          "default": false
        }
      ]
    },
    "enable-status": {
      "groups": [
        "server"
      ],
      "description": {
        "ja": "サーバーの選択画面でオンライン状態の表示をする",
        "en-US": "Display online status on the server selection screen"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "20w18a"
          },
          "type": "boolean",
          "default": true
        }
      ]
    },
    "enforce-secure-profile": {
      "groups": [
        "security"
      ],
      "description": {
        "ja": "Mojang署名の公開鍵を持っているプレイヤーにのみ接続を許可する",
        "en-US": "Allow connections only to players who have Mojang-signed public keys"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "1.19.1-pre2"
          },
          "type": "boolean",
          "default": true
        },
        {
          "minecraftVersion": {
            "from": "22w17a",
            "to": "1.19.1-rc1"
          },
          "type": "boolean",
          "default": false
        }
      ]
    },
    "enforce-whitelist": {
      "groups": [
        "security"
      ],
      "description": {
        "ja": "ホワイトリストの再読み込み時に，ホワイトリストに登録されていないオンラインのプレイヤーをキックする",
        "en-US": "Kick online players who are not on the whitelist when the whitelist is reloaded"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "18w19a"
          },
          "type": "boolean",
          "default": false
        }
      ]
    },
    "entity-broadcast-range-percentage": {
      "groups": [
        "world"
      ],
      "description": {
        "ja": "エンティティの情報をクライアントに送信する距離を，既定の距離に対する割合（%）で指定する",
        "en-US": "Distance within which entities are sent to clients, as a percentage of the default distance"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "20w18a"
          },
          "type": "number",
          "default": 100,
          "min": 10,
          "max": 1000,
          "step": 1
        }
      ]
    },
    "force-gamemode": {
      "groups": [
        "player"
      ],
      "description": {
        "ja": "ゲームモードをログイン時に強制する",
        "en-US": "Enforce game mode at login"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "13w16a"
          },
          "type": "boolean",
          "default": false
        }
      ]
    },
    "function-permission-level": {
      "groups": [
        "command"
      ],
      "description": {
        "ja": "関数（function）から実行するコマンドの権限レベル（1~4で指定）",
        "en-US": "Permission level of commands run by functions (set between 1 to 4)"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "1.14.4-pre4"
          },
          "type": "number",
          "default": 2,
          "min": 1,
          "max": 4,
          "step": 1
        }
      ]
    },
    "gamemode": {
      "groups": [
        "base",
        "player"
      ],
      "description": {
        "ja": "ゲーム内でのゲームモード",
        "en-US": "Gamemode in the game"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "18w48a"
          },
          "type": "string",
          "default": "survival",
          "enum": [
            "survival",
            "creative",
            "adventure",
            "spectator"
          ]
        },
        {
          "minecraftVersion": {
            "to": "18w47b"
          },
          "type": "string",
          "default": "0",
          "enum": [
            "0",
            "1",
            "2",
            "3"
          ]
        }
      ]
    },
    "generate-structures": {
      "groups": [
        "generator"
      ],
      "description": {
        "ja": "構造物（村など）の生成をする",
        "en-US": "Generate structures(such as villages)"
      },
      "definitions": [
        {
          "type": "boolean",
          "default": true
        }
      ]
    },
    "generator-settings": {
      "groups": [
        "generator"
      ],
      "description": {
        "ja": "ワールド生成のカスタマイズ(JSON)",
        "en-US": "Customize world generation. (JSON)"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "21w17a"
          },
          "type": "string",
          "default": "{}"
        },
        {
          "minecraftVersion": {
            "from": "1.4",
            "to": "21w16a"
          },
          "type": "string",
          "default": ""
        }
      ]
    },
    "hardcore": {
      "groups": [
        "player"
      ],
      "description": {
        "ja": "ハードコアに設定する",
        "en-US": "Set gamemode to hardcore"
      },
      "definitions": [
        {
          "type": "boolean",
          "default": false
        }
      ]
    },
    "hide-online-players": {
      "groups": [
        "player"
      ],
      "description": {
        "ja": "サーバーの選択画面に，オンラインのプレイヤーの名前を表示しない",
        "en-US": "Do not show the names of online players on the server selection screen"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "21w44a"
          },
          "type": "boolean",
          "default": false
        }
      ]
    },
    "initial-disabled-packs": {
      "groups": [
        "generator"
      ],
      "description": {
        "ja": "ワールドの新規作成時に自動で有効にしないデータパックをカンマ区切りで指定（作成済みのワールドには反映されない）",
        "en-US": "Comma-separated data packs not to enable automatically when the world is created (no effect on existing worlds)"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "22w42a"
          },
          "type": "string",
          "default": ""
        }
      ]
    },
    "initial-enabled-packs": {
      "groups": [
        "generator"
      ],
      "description": {
        "ja": "ワールドの新規作成時に有効にするデータパックをカンマ区切りで指定（実験的機能のパックは明示が必要，作成済みのワールドには反映されない）",
        "en-US": "Comma-separated data packs to enable when the world is created (feature packs must be listed explicitly; no effect on existing worlds)"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "22w42a"
          },
          "type": "string",
          "default": "vanilla"
        }
      ]
    },
    "level-seed": {
      "groups": [
        "generator"
      ],
      "description": {
        "ja": "ワールドのシード値",
        "en-US": "World seed value"
      },
      "definitions": [
        {
          "type": "string",
          "default": ""
        }
      ]
    },
    "level-type": {
      "groups": [
        "generator"
      ],
      "description": {
        "ja": "ワールドの生成タイプ",
        "en-US": "World generation value"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "22w11a"
          },
          "type": "string",
          "default": "minecraft:normal",
          "enum": [
            "minecraft:normal",
            "minecraft:flat",
            "minecraft:large_biomes",
            "minecraft:amplified",
            "minecraft:single_biome_surface"
          ]
        },
        {
          "minecraftVersion": {
            "from": "18w48a",
            "to": "1.18.2"
          },
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "flat",
            "largeBiomes",
            "amplified",
            "buffet"
          ]
        },
        {
          "minecraftVersion": {
            "to": "18w47b"
          },
          "type": "string",
          "default": "DEFAULT",
          "enum": [
            "DEFAULT",
            "FLAT",
            "LARGEBIOMES",
            "AMPLIFIED",
            "CUSTOMIZED",
            "BUFFET"
          ]
        }
      ]
    },
    "log-ips": {
      "description": {
        "ja": "プレイヤーがサーバーに参加した際に，プレイヤーのIPアドレスをログに記録する",
        "en-US": "Record the IP address of players in the log when they join the server"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "23w31a"
          },
          "type": "boolean",
          "default": true
        }
      ]
    },
    "management-server-allowed-origins": {
      "description": {
        "ja": "管理用プロトコルへの接続を許可するオリジンの一覧をカンマ区切りで指定（空欄の場合はどこからも接続できない）",
        "en-US": "Origins (comma-separated) that may open a Management Protocol connection (no client can connect when empty)"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "25w42a"
          },
          "type": "string",
          "default": ""
        }
      ]
    },
    "management-server-enabled": {
      "description": {
        "ja": "外部ツールからサーバーを管理・監視するための管理用プロトコル（Management Protocol）を有効化する",
        "en-US": "Enable the Management Protocol, which lets external tools manage and monitor the server"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "25w35a"
          },
          "type": "boolean",
          "default": false
        }
      ]
    },
    "management-server-host": {
      "description": {
        "ja": "管理用プロトコルが待ち受けるホスト名",
        "en-US": "Host name the Management Protocol listens on"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "25w35a"
          },
          "type": "string",
          "default": "localhost"
        }
      ]
    },
    "management-server-port": {
      "description": {
        "ja": "管理用プロトコルが待ち受けるポート番号（0の場合は起動時にランダムなポートを割り当てる）",
        "en-US": "Port number the Management Protocol listens on (0 to assign a random port at startup)"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "25w37a"
          },
          "type": "number",
          "default": 0,
          "min": 0,
          "max": 65535,
          "step": 1
        },
        {
          "minecraftVersion": {
            "from": "25w35a",
            "to": "25w36b"
          },
          "type": "number",
          "default": 25585,
          "min": 0,
          "max": 65535,
          "step": 1
        }
      ]
    },
    "management-server-secret": {
      "description": {
        "ja": "管理用プロトコルに接続する際の認証に使う40文字の英数字（空欄の場合は自動生成）",
        "en-US": "40-character alphanumeric secret used to authenticate Management Protocol clients (generated automatically when empty)"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "25w37a"
          },
          "type": "string",
          "default": ""
        }
      ]
    },
    "management-server-tls-enabled": {
      "description": {
        "ja": "管理用プロトコルの通信をTLSで暗号化する",
        "en-US": "Encrypt Management Protocol communication with TLS"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "25w37a"
          },
          "type": "boolean",
          "default": true
        }
      ]
    },
    "management-server-tls-keystore": {
      "description": {
        "ja": "TLSで使用するキーストアファイルのパス（TLSを有効にしたまま未指定にするとサーバーが起動しない）",
        "en-US": "Location of the TLS keystore file (required while TLS is on, otherwise the server fails to start)"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "25w37a"
          },
          "type": "string",
          "default": ""
        }
      ]
    },
    "management-server-tls-keystore-password": {
      "description": {
        "ja": "TLSで使用するキーストアファイルのパスワード",
        "en-US": "Password for opening the TLS keystore file"
      },
      "definitions": [
        {
          "minecraftVersion": {
            "from": "25w37a"
          },
          "type": "string",
          "default": ""
        }
      ]
    },
    "max-build-height": {
      "groups": [
        "generator"
      ],
      "description": {
